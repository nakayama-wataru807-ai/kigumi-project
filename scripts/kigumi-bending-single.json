{
    "boundary_conditions": {
        "rhs": [0, 0, 0],
        "neumann_boundary": [{ 
            "id": 2, 
            "value": [0.0, "0.2 * t", 0]
        }],
        "dirichlet_boundary": [{
            "id": 1, 
            "value": [0, 0, 0], 
            "dimension": [true, true, true] 
            }
        ]
    },
    "contact": {
        "epsv": 1e-3,
        "friction_coefficient": 0,
        "use_convergent_formulation": false,
        "use_gcp_formulation": false,
        "use_adaptive_dhat": false,
        "enabled": false,
        "dhat": 1.0e-1
    },
    "geometry": [{
        "mesh": "../meshes/Koshikake-Kama_005edge_M.msh",
        "transformation": {
            "rotation": [0, 0, 0],
            "scale": 1.0,
            "translation": [0, 0, 0]
        },
        "volume_selection": 1,
        "surface_selection": [{
            "id": 1,
            "axis": "+X",
            "position": 1.0,
            "relative": true
        }, {
            "id": 2,
            "axis": "-X",
            "position": 0.0,
            "relative": true
        }]
    }],
    "materials": [{
        "E": 8e0,
        "id": 1,
        "nu": 0.35,
        "rho": 4e-7,
        "type": "NeoHookean"
    }],
    "time": {
        "tend": 1,
        "dt": 0.1,
        "integrator": "ImplicitEuler",
        "quasistatic": true
    },
    "units":
    {
        "length": "mm",
        "mass": "kg",
        "time": "ms"
    },
    "solver": {
        "contact": {
            "CCD": {
                "broad_phase": "hash_grid",
                "max_iterations": 1000,
                "tolerance": 1.0e-5
            },
            "friction_convergence_tol": 0.01,
            "friction_iterations": 1,
            "barrier_stiffness": "adaptive"
        },
        "linear": {
            "solver": [
                "Eigen::PardisoLDLT",
                "Eigen::AccelerateLDLT",
                "Eigen::CholmodSupernodalLLT",
                "Eigen::SimplicialLDLT"
            ]
        },
        "nonlinear": {
            "Newton": {
                "force_psd_projection": false,
                "reg_weight_inc": 10,
                "reg_weight_max": 100000000.0,
                "reg_weight_min": 1e-08,
                "residual_tolerance": 1e-05,
                "use_psd_projection": true,
                "use_psd_projection_in_regularized": true
            },
            "iterations_per_strategy": 1,
            "line_search": {
                "method": "RobustArmijo"
            },
            "solver": "Newton",
            "max_iterations": 10000,
            "x_delta": 1e-12,
            "grad_norm": 1e-5
        },
        "advanced": {
            "lump_mass_matrix": true
        }
    },
    "space":{
        "remesh": {
            "enabled": false
        }
    },
    "output": {
        "json": "sim_bending.json",
        "log": {
            "level": "debug"
        },
        "paraview": {
            "file_name": "sim_bending.pvd",
            "options": {
                "material": true,
                "body_ids": true,
                "tensor_values": false,
                "discretization_order": true,
                "nodes": true,
                "contact_forces": true,
                "friction_forces": true
            },
            "surface": true,
            "skip_frame": 1,
            "vismesh_rel_area": 10000000,
            "points": true
        },
        "advanced": {
            "save_solve_sequence_debug": false,
            "save_time_sequence": true,
            "save_nl_solve_sequence": true
        }
    }
}
